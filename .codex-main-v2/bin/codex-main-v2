#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
codex_home="$repo_root/.codex-main-v2"
guard="$codex_home/hooks/ponytail-branch-guard.sh"
bootstrap="$codex_home/bin/bootstrap-ponytail"

if [ ! -x "$guard" ]; then
  echo "Ponytail guard is missing or not executable: $guard" >&2
  exit 1
fi

"$guard"

export CODEX_HOME="$codex_home"

if [ ! -d "$codex_home/plugins/cache/ponytail/ponytail" ]; then
  if [ ! -x "$bootstrap" ]; then
    echo "Ponytail bootstrap is missing or not executable: $bootstrap" >&2
    exit 1
  fi
  "$bootstrap"
fi

exec codex --dangerously-bypass-approvals-and-sandbox "$@"
