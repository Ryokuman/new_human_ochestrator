# system은 여러 프로젝트에서 재사용할 프롬프트/에이전트 설계 모음집입니다.
# 아래 항목은 시크릿, 로컬 산출물, 특정 프로젝트 의존 자료라서 git에 올리지 않습니다.

# 시크릿과 인증 자료
.env
.env.*
!.env.example
!.env.template
secrets/
secret/
credentials/
credential/
vault/
private/
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.kubeconfig
*.mobileprovision
*.provisionprofile
*secret*
*Secret*
*credential*
*Credential*
*password*
*Password*
*token*
*Token*
*api-key*
*api_key*
!config/silo-secrets.example.yaml

# 로컬 실행/검증 산출물
.cache/
.tmp/
tmp/
temp/
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.dump
*.har
*.trace
*.webm
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.gif

# 프로젝트별 override를 둘 때 사용하는 로컬 전용 공간
local/
project-local/
project-overrides/
workspace-local/

# 실제 프로젝트/사일로 런타임 설정
config/*.env
!config/*.env.example
config/*.local.yaml
config/*.local.yml
config/shared-runtime-registry.yaml
config/shared-runtime-registry.yml
config/silo-projects.yaml
config/silo-projects.yml
config/silo-secrets.yaml
config/silo-secrets.yml
config/public-export-manifest.yaml
config/public-export-manifest.yml
