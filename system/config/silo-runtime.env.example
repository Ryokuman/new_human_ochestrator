# 사일로 런타임 env 템플릿
# 실제 값 파일은 `silo-runtime.env`로 만들고 git에 올리지 않습니다.

# 작업 루트
SILO_WORK_ROOT=/tmp/agent-silos

# 프로젝트 목록 설정 파일
SILO_PROJECTS_CONFIG=./system/config/silo-projects.yaml

# 기본 보호 브랜치. 프로젝트별 설정이 없을 때 fallback으로 사용합니다.
SILO_DEFAULT_PROTECTED_BRANCHES=main,master,dev,develop,release,production

# 사일로 작업 브랜치 prefix
SILO_BRANCH_PREFIX=silo

# 실행 모드
# yolo: 격리 clone + 새 브랜치 안에서는 승인 없이 과감하게 수정합니다.
# safe: 수정 전 계획/승인 단계를 더 자주 둡니다.
SILO_EXECUTION_MODE=yolo
SILO_YOLO_ALLOW_FREE_SOURCE_EDITS=true
SILO_YOLO_ALLOW_GENERATED_OUTPUT_EDITS=true
SILO_YOLO_ALLOW_TEST_AND_TOOLING_EDITS=true
SILO_YOLO_REQUIRE_PROTECTED_BRANCH_GUARD=true
SILO_YOLO_REQUIRE_SECRET_GUARD=true
SILO_YOLO_REQUIRE_PRODUCTION_GUARD=true

# clone 정책
SILO_CLONE_DEPTH=1
SILO_ALLOW_PARTIAL_CLONE=true
SILO_DELETE_WORKDIR_ON_FAILURE=true

# PR 정책
SILO_REQUIRE_PR_DESCRIPTION=true
SILO_REQUIRE_PROMOTION_SECTIONS=true
SILO_REQUIRE_BRANCH_SAFETY_REPORT=true

# 검증 정책
SILO_REQUIRE_AGENT_BROWSER_FOR_UI=true
SILO_ALLOW_NETWORK=true

# 시크릿 공급 방식
# env, file, secret-manager 중 하나를 사용합니다.
SILO_SECRET_PROVIDER=env
SILO_SECRETS_FILE=./system/config/silo-secrets.yaml
